# Streamlit Secrets Configuration Example
# Copy this file to .streamlit/secrets.toml for local development or enter secrets in Streamlit Cloud Dashboard.
# NOTE: LeakLens AI operates completely locally with rule-based heuristics and does NOT require paid external AI keys.

# Optional AI Verification Service (Leave empty or omitted for standard rule-based mode)
# AI_PROVIDER = "none"
# AI_API_KEY = ""

[environment]
APP_NAME = "LeakLens AI"
ENVIRONMENT = "production"
MAX_UPLOAD_MB = 50
